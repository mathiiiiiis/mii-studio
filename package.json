{
  "name": "mii-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pose and animation authoring for Mii Creator Miis (not affiliated)",
  "scripts": {
    "build": "npm run rig --silent && vite build",
    "dev": "npm run rig --silent && vite",
    "rig": "node bin/dump-rig.js",
    "read": "node bin/read-pose.js",
    "ranges": "node bin/dump-ranges.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "sass": "^1.103.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "three": "^0.185.1",
    "vue": "^3.5.41"
  }
}
